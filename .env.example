# ── 관리자 페이지 (/admin) ──────────────────────────────────────────
# /admin 접속 시 입력하는 비밀번호입니다. 값을 채우지 않으면 로그인이 항상 실패합니다.
ADMIN_PASSWORD=

# 로그인 세션 쿠키에 서명할 때 쓰는 임의의 문자열입니다.
# 아무 의미 없는 긴 무작위 문자열로 채워두면 됩니다. (비워두면 ADMIN_PASSWORD로 대체되어 동작은 하지만,
# 보안을 위해 되도록 별도 값을 넣어주세요)
ADMIN_SESSION_SECRET=

# ── Firebase (주점 등록 데이터 저장) ──────────────────────────────────
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은
# JSON 파일 안의 값을 그대로 옮겨 적으면 됩니다. 서버(Server Action)에서만 쓰이며
# 브라우저로는 절대 전달되지 않습니다.
#
# 주의: 클라이언트용 Firebase SDK(firebase 패키지)를 위한 apiKey 등은 필요 없습니다 -
# 이 프로젝트는 firebase-admin으로 서버에서만 Firestore에 접근합니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key 값의 줄바꿈(\n)은 그대로 두고 큰따옴표로 감싸서 붙여넣으세요.
# 예: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# 이 파일은 예시용입니다. 실제 값은 .env.local에 넣고 커밋하지 마세요 (.gitignore에 이미 포함되어 있음).
